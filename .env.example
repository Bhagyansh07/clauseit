# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored and must NEVER be committed or pushed.
# Keep secret keys server-side only. NEVER prefix a secret with NEXT_PUBLIC_.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session signing (random string, at least 32 chars). If empty, a secret is
# generated and stored in .data/secret automatically.
AUTH_SECRET=your-long-random-secret-string

# Supabase (create at https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Google Gemini (create at https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key

# Razorpay (create at https://razorpay.com)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Upstash Redis rate limiting (create at https://upstash.com)
UPSTASH_REDIS_REST_URL=your-upstash-redis-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token

# Sentry (create at https://sentry.io)
SENTRY_DSN=your-sentry-dsn
